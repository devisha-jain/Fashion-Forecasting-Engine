# =======================================================
# AI-Powered Fashion Trend Intelligence & Forecasting System
# Environment Variables Configuration
# =======================================================

# Google Gemini API Key (Required for LLM Semantic Trend Analysis)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Redis Cache URL (Optional — supports local Redis or Upstash cloud Redis)
# Example: rediss://default:token@host:port or redis://localhost:6379
REDIS_URL=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Unsplash API Access Key (Optional — for dynamic visual references)
UNSPLASH_ACCESS_KEY=

# Allowed CORS Origins (Comma-separated or * for development)
ALLOWED_ORIGINS=*

# Frontend API URL (Used by Next.js client to reach Flask backend)
NEXT_PUBLIC_API_URL=http://localhost:5000
